<?php
/**
 * My Clients — clean installation wizard.
 * Creates empty data stores + config.local.php, then redirects to admin setup.
 *
 * URL: /myclient/cms/install.php
 */
declare(strict_types=1);

error_reporting(E_ALL);
ini_set('display_errors', '0');

$root = __DIR__;
$dataDir = $root . '/data';
$lockFile = $dataDir . '/installed.lock';

function mk_install_h(?string $s): string
{
    return htmlspecialchars($s ?? '', ENT_QUOTES, 'UTF-8');
}

function mk_install_detect_base(): string
{
    $script = str_replace('\\', '/', (string) ($_SERVER['SCRIPT_NAME'] ?? ''));
    $dir = rtrim(str_replace('\\', '/', dirname($script)), '/');
    if (str_ends_with($dir, '/admin')) {
        $dir = substr($dir, 0, -6);
    }
    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host = (string) ($_SERVER['HTTP_HOST'] ?? 'localhost');

    return $scheme . '://' . $host . ($dir === '' || $dir === '/' ? '' : $dir);
}

function mk_install_write_json(string $path, array $data): bool
{
    $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    if ($json === false) {
        return false;
    }
    $tmp = $path . '.tmp';
    if (file_put_contents($tmp, $json . "\n", LOCK_EX) === false) {
        return false;
    }

    return rename($tmp, $path);
}

/** Default service catalog for a fresh install (no clients / invoices). */
function mk_install_default_services(): array
{
    $now = date('Y-m-d H:i:s');

    return [
        'items' => [
            [
                'id' => 'svc_site_maintenance',
                'name' => ['uk' => 'Обслуговування сайту', 'no' => 'Nettstedvedlikehold', 'en' => 'Site maintenance'],
                'desc' => [
                    'uk' => 'Річний догляд: оновлення, моніторинг, підтримка.',
                    'no' => 'Årlig oppfølging: oppdatering, overvåking, support.',
                    'en' => 'Yearly care: updates, monitoring, support.',
                ],
                'icon' => '🛠️',
                'price_m1' => 116,
                'price_m3' => 348,
                'price_m12' => 1393,
                'active' => true,
                'sort' => 1,
                'billing_mode' => 'year',
                'created_at' => $now,
                'updated_at' => $now,
            ],
            [
                'id' => 'svc_seo_specialist',
                'name' => ['uk' => 'SEO-спеціаліст', 'no' => 'SEO-spesialist', 'en' => 'SEO specialist'],
                'desc' => [
                    'uk' => 'Щомісячна SEO-оптимізація та звіти.',
                    'no' => 'Månedlig SEO-optimalisering og rapporter.',
                    'en' => 'Monthly SEO optimisation and reports.',
                ],
                'icon' => '📈',
                'price_m1' => 928,
                'price_m3' => 2784,
                'price_m12' => 11136,
                'active' => true,
                'sort' => 2,
                'billing_mode' => 'month',
                'created_at' => $now,
                'updated_at' => $now,
            ],
            [
                'id' => 'svc_extra_sites_5',
                'name' => ['uk' => '+5 додаткових сайтів', 'no' => '+5 ekstra nettsteder', 'en' => '+5 additional websites'],
                'desc' => [
                    'uk' => 'Розширте ліміт сайтів на 5',
                    'no' => 'Utvid nettstedgrensen med 5',
